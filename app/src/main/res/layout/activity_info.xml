<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFDF9"
    android:padding="20dp"
    tools:context=".InfoActivity">

    <ImageView
        android:id="@+id/imagemInfo"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:contentDescription="Imagem do filme"
        android:scaleType="fitCenter"
        android:src="@drawable/clapperboard"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/baloo_bhaijaan"
        android:gravity="center"
        android:text="Nome do filme"
        android:textColor="#1C1C1C"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/imagemInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Interestelar" />

    <TextView
        android:id="@+id/textGenero"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/baloo_bhaijaan"
        android:text="Gênero: Ficção científica"
        android:textColor="#C62828"
        android:textSize="17sp"
        app:layout_constraintTop_toBottomOf="@id/textTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Gênero: Ficção científica" />

    <TextView
        android:id="@+id/textAno"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/baloo_bhaijaan"
        android:text="Ano: 2014"
        android:textColor="#C62828"
        android:textSize="17sp"
        app:layout_constraintTop_toBottomOf="@id/textGenero"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Ano: 2014" />

    <TextView
        android:id="@+id/textd"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/baloo_bhaijaan"
        android:text="Sinopse"
        android:textColor="#1C1C1C"
        android:textSize="21sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/textAno"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textDescricao"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:gravity="top"
        android:text="Descrição do filme..."
        android:textColor="#333333"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/textd"
        app:layout_constraintBottom_toTopOf="@id/button_voltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Um explorador embarca em uma missão espacial para encontrar um novo lar para a humanidade." />

    <Button
        android:id="@+id/button_voltar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#C62828"
        android:text="Voltar"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
